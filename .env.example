# --- Telegram bot ---
TELEGRAM_BOT_TOKEN=                       # @BotFather token
TELEGRAM_BOT_USERNAME=                    # without @, e.g. ton_poker_bot
MINI_APP_URL=http://localhost:5173        # Mini App frontend URL (set in BotFather → /newapp)
WEBHOOK_URL=                              # public URL for bot webhook (optional, dev uses long-poll)

# --- Crypto Pay (CryptoBot) ---
# Mainnet: pay.crypt.bot   |   Testnet: testnet-pay.crypt.bot
CRYPTO_PAY_API_URL=https://testnet-pay.crypt.bot
CRYPTO_PAY_TOKEN=                         # @CryptoTestnetBot or @CryptoBot → /pay → Create App
CRYPTO_PAY_WEBHOOK_SECRET=                # optional, set to verify webhook signatures

# --- Server ---
NODE_ENV=development
PORT=3000
PUBLIC_URL=http://localhost:3000          # used in invoice payloads & callbacks
JWT_SECRET=change-me-in-production-please-make-it-long
DATABASE_URL=postgresql://poker:poker@localhost:5432/ton_poker
REDIS_URL=redis://localhost:6379

# --- Pricing & monetization ---
STAR_USD_PRICE=0.013                      # net USD developer receives per Star (after TG fee)
TG_STAR_FEE_RATIO=0.30                    # Telegram's commission share (info only)
STARS_MARGIN=0.15                         # our markup on Stars→TON conversion
TON_PRICE_REFRESH_SEC=60
RAKE_PERCENT=5                            # % of pot taken as rake
RAKE_CAP_BB=3                             # cap rake at N big blinds
TOURNAMENT_FEE_PERCENT=10
VIP_RAKEBACK_PERCENT=30

# --- Limits ---
MIN_DEPOSIT_TON=0.5
MAX_DEPOSIT_TON_NO_KYC_MONTHLY=1000
MIN_WITHDRAW_TON=1
WITHDRAW_FEE_TON=0.1

# --- Anti-fraud ---
GEO_BLOCK_COUNTRIES=                      # comma-separated ISO codes to block (e.g. RU,BY,US)
ALLOW_BOT_USERS=false                     # if false, refuse Telegram users marked as bots
