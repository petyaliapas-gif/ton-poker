{
  "name": "@ton-poker/shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./poker": {
      "types": "./dist/poker/index.d.ts",
      "import": "./dist/poker/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "echo 'lint via root tsc'",
    "test": "tsc -p tsconfig.test.json && node --test --enable-source-maps 'dist-test/**/*.test.js'"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "typescript": "^5.6.3"
  }
}
